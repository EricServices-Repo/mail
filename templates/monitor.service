[Unit]
Description=Eric Mail health and security checks
After=network-online.target
OnFailure=eric-mail-alert@%n.service
[Service]
Type=oneshot
ExecStart=/opt/eric-mail/current/install.sh health --config /etc/eric-mail/site.json
User=root
UMask=0077
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/eric-mail
